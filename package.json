{
  "name": "my-context",
  "version": "0.1.0",
  "private": true,
  "description": "Private Markdown knowledge served through Context Hub MCP",
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker": "npx --yes wrangler@4.165.0",
    "search": "CHUB_DIR=./.local/chub CHUB_TELEMETRY=0 CHUB_FEEDBACK=0 chub search",
    "get": "CHUB_DIR=./.local/chub CHUB_TELEMETRY=0 CHUB_FEEDBACK=0 chub get",
    "setup": "node scripts/setup-local.mjs",
    "install:user": "node scripts/install-user.mjs",
    "install:workflow": "node scripts/install-workflow.mjs",
    "test:workflow": "node --test test/workflow-contract.test.mjs test/install-workflow.test.mjs"
  },
  "dependencies": {
    "@aisuite/chub": "0.1.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.18",
    "supergateway": "4.2.2",
    "zod": "4.6.7"
  }
}
