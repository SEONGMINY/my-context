{
  "name": "my-context",
  "version": "0.1.0",
  "private": true,
  "description": "Git-backed personal development principles and reusable agent workflows served through read-only MCP",
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker": "npx --yes wrangler@4.165.0",
    "install:user": "node scripts/install-user.mjs",
    "install:workflow": "node scripts/install-workflow.mjs",
    "policy:check": "node scripts/install-asset-usage.mjs --check",
    "policy:enable": "node scripts/install-asset-usage.mjs --enable",
    "policy:disable": "node scripts/install-asset-usage.mjs --disable",
    "test:workflow": "node --test test/install-workflow.test.mjs test/install-user.test.mjs",
    "test:integrity": "node --test test/principle-cases.test.mjs test/asset-policy.test.mjs test/asset-integrity.test.mjs test/korean-search.test.mjs"
  },
  "dependencies": {
    "@aisuite/chub": "0.1.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.18",
    "supergateway": "4.2.2",
    "zod": "4.6.7"
  }
}
